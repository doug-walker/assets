#usda 1.0
(
    defaultPrim = "ColorSpaceTest"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "ColorSpaceTest"
{
    def Scope "Materials"
    {
        def Material "Background"
        {
            token outputs:surface.connect = </ColorSpaceTest/Materials/Background/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.0072, 0.0072, 0.0072)
                float inputs:metallic = 0
                float inputs:roughness = 1
                token outputs:surface
            }
        }

        def Material "Material_01_R0C0"
        {
            token outputs:surface.connect = </ColorSpaceTest/Materials/Material_01_R0C0/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:emissiveColor.connect = </ColorSpaceTest/Materials/Material_01_R0C0/Texture.outputs:rgb>
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/lin_rec709.hdr@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </ColorSpaceTest/Materials/Material_01_R0C0/stReader.outputs:result>
                color3f outputs:rgb
            }
        }

