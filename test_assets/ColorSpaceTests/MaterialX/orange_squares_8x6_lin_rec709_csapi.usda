#usda 1.0
(
    customLayerData = {
        string colorSpace = "lin_p3d65_scene"
    }
    defaultPrim = "Plane"
    metersPerUnit = 0.01
    renderSettingsPrimPath = "/RenderSettings"
    upAxis = "Y"
)

def RenderSettings "RenderSettings"
{
    uniform token renderingColorSpace = "lin_rec709_scene"
}

def Xform "Plane"
{
    def Mesh "PlaneMesh" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-1, -1, 0), (1, 1, 0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </MaterialX/Materials/orange_squares_8x6>
        point3f[] points = [(-1, -1, 0), (1, -1, 0), (1, 1, 0), (-1, 1, 0)]
        texCoord2f[] primvars:st = [(0, 1), (1, 1), (1, 0), (0, 0)] (
            interpolation = "varying"
        )
    }
}

def "MaterialX"
{
    def "Materials"
    {
        def Material "orange_squares_8x6" (
            prepend apiSchemas = ["MaterialXConfigAPI"]
        )
        {
            string config:mtlx:version = "1.39"
            float inputs:emission
            color3f inputs:emission_color
            float inputs:opacity
            float inputs:transmission
            color3f inputs:transmission_color
            token outputs:mtlx:surface.connect = </MaterialX/Materials/orange_squares_8x6/surf_unlit1.outputs:surface>

            def Shader "surf_unlit1" (
                prepend references = </MaterialX/Shaders/surf_unlit1>
            )
            {
                float inputs:emission.connect = </MaterialX/Materials/orange_squares_8x6.inputs:emission>
                color3f inputs:emission_color.connect = </MaterialX/Materials/orange_squares_8x6/NodeGraphs/switches.outputs:out>
                float inputs:opacity.connect = </MaterialX/Materials/orange_squares_8x6.inputs:opacity>
                float inputs:transmission.connect = </MaterialX/Materials/orange_squares_8x6.inputs:transmission>
                color3f inputs:transmission_color.connect = </MaterialX/Materials/orange_squares_8x6.inputs:transmission_color>
            }

            def "NodeGraphs" (
                prepend references = </MaterialX/NodeGraphs>
            )
            {
            }
        }
    }

    def "Shaders"
    {
        def Shader "surf_unlit1"
        {
            uniform token info:id = "ND_surface_unlit"
            token outputs:surface
        }
    }

