#usda 1.0
(
    metersPerUnit = 0.01
    upAxis = "Y"
    defaultPrim = "Plane"
)

def Xform "Plane"
{
    def Mesh "PlaneMesh" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-1, -1, 0), (1, 1, 0)]
        point3f[] points = [
            (-1, -1, 0), (1, -1, 0), (1, 1, 0), (-1, 1, 0)
        ]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "varying"
        )

        rel material:binding = </mtl/test_materialSG>
    }
}

def Scope "mtl"
{
    def Material "test_materialSG"
    {
        token outputs:mtlx:surface.connect = </mtl/test_materialSG/test_material.outputs:out>

        def Shader "test_material"
        {
            uniform token info:id = "ND_surface_unlit"
            color3f inputs:emission_color.connect = </mtl/test_materialSG/switches.outputs:out>
            token outputs:out
        }

        def Shader "tex1" 
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }

        def Shader "ext_y" 
        {
            uniform token info:id = "ND_extract_vector2"
            float2 inputs:in.connect = </mtl/test_materialSG/tex1.outputs:out>
            int inputs:index = 1
            float outputs:out
        }

        def Shader "mul_y" 
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </mtl/test_materialSG/ext_y.outputs:out>
            float inputs:in2 = 5
            float outputs:out
        }

        def Shader "ext_x" 
        {
            uniform token info:id = "ND_extract_vector2"
            float2 inputs:in.connect = </mtl/test_materialSG/tex1.outputs:out>
            int inputs:index = 0
            float outputs:out
        }

        def Shader "mul_x" 
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </mtl/test_materialSG/ext_x.outputs:out>
            float inputs:in2 = 5
            float outputs:out
        }

        def Shader "switch1" 
        {
            uniform token info:id = "ND_switch_color3"
            color3f inputs:in1 = (0.784313, 0.39216, 0.196076) (
                colorSpace = "srgb_texture"
            )
            color3f inputs:in2 = (0.73716, 0.318381, 0.147482) (
                colorSpace = "g18_rec709"
            )
            color3f inputs:in3 = (0.779186, 0.392031, 0.20887) (
                colorSpace = "g22_rec709"
            )
            color3f inputs:in4 = (0.795557, 0.423849, 0.237987) (
                colorSpace = "rec709_display"
            )
            color3f inputs:in5 = (0.398892, 0.157752, 0.0536138) (
                colorSpace = "acescg"
            )
            float inputs:which.connect = </mtl/test_materialSG/mul_x.outputs:out>
            color3f outputs:out
        }

        def Shader "switch2" 
        {
            uniform token info:id = "ND_switch_color3"
            color3f inputs:in1 = (0.658522, 0.431959, 0.264483) (
                colorSpace = "g22_ap1"
            )
            color3f inputs:in2 = (0.733815, 0.413301, 0.24304) (
                colorSpace = "srgb_displayp3"
            )
            color3f inputs:in3 = (0.497662, 0.142382, 0.0481343) (
                colorSpace = "lin_displayp3"
            )
            color3f inputs:in4 = (0.449346, 0.12744, 0.0358282) (
                colorSpace = "lin_adobergb"
            )
            color3f inputs:in5 = (0.497662, 0.142382, 0.0481343) (
                colorSpace = "lin_displayp3"
            )
            float inputs:which.connect = </mtl/test_materialSG/mul_x.outputs:out>
            color3f outputs:out
        }

        def Shader "switch3_srgb_texture" 
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @textures/srgb_texture.hdr@ (
                colorSpace = "srgb_texture"
            )
            color3f outputs:out
        }

        def Shader "switch3_g18_rec709" 
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @textures/g18_rec709.hdr@ (
                colorSpace = "g18_rec709"
            )
            color3f outputs:out
        }

        def Shader "switch3_g22_rec709" 
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @textures/g22_rec709.hdr@ (
                colorSpace = "g22_rec709"
            )
            color3f outputs:out
        }

        def Shader "switch3_rec709_display" 
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @textures/rec709_display.hdr@ (
                colorSpace = "rec709_display"
            )
            color3f outputs:out
        }

        def Shader "switch3_acescg" 
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @textures/acescg.hdr@ (
                colorSpace = "acescg"
            )
            color3f outputs:out
        }

        def Shader "switch3" 
        {
            uniform token info:id = "ND_switch_color3"
            color3f inputs:in1.connect = </mtl/test_materialSG/switch3_srgb_texture.outputs:out>
            color3f inputs:in2.connect = </mtl/test_materialSG/switch3_g18_rec709.outputs:out>
            color3f inputs:in3.connect = </mtl/test_materialSG/switch3_g22_rec709.outputs:out>
            color3f inputs:in4.connect = </mtl/test_materialSG/switch3_rec709_display.outputs:out>
            color3f inputs:in5.connect = </mtl/test_materialSG/switch3_acescg.outputs:out>
            float inputs:which.connect = </mtl/test_materialSG/mul_x.outputs:out>
            color3f outputs:out
        }

        def Shader "switch4_adobergb" 
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @textures/adobergb.hdr@ (
                colorSpace = "adobergb"
            )
            color3f outputs:out
        }

        def Shader "switch4_lin_adobergb" 
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @textures/lin_adobergb.hdr@ (
                colorSpace = "lin_adobergb"
            )
            color3f outputs:out
        }

        def Shader "switch4_lin_displayp3" 
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @textures/lin_displayp3.hdr@ (
                colorSpace = "lin_displayp3"
            )
            color3f outputs:out
        }

        def Shader "switch4_srgb_displayp3" 
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @textures/srgb_displayp3.hdr@ (
                colorSpace = "srgb_displayp3"
            )
            color3f outputs:out
        }

        def Shader "switch4_untagged_lin_displayp3" 
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @textures/lin_displayp3.hdr@ (
                colorSpace = "lin_displayp3"
            )
            color3f outputs:out
        }

        def Shader "switch4" 
        {
            uniform token info:id = "ND_switch_color3"
            color3f inputs:in1.connect = </mtl/test_materialSG/switch4_adobergb.outputs:out>
            color3f inputs:in2.connect = </mtl/test_materialSG/switch4_lin_adobergb.outputs:out>
            color3f inputs:in3.connect = </mtl/test_materialSG/switch4_lin_displayp3.outputs:out>
            color3f inputs:in4.connect = </mtl/test_materialSG/switch4_srgb_displayp3.outputs:out>
            color3f inputs:in5.connect = </mtl/test_materialSG/switch4_untagged_lin_displayp3.outputs:out>
            float inputs:which.connect = </mtl/test_materialSG/mul_x.outputs:out>
            color3f outputs:out
        }

        def NodeGraph "NG_switch5" 
        {
            float inputs:ng_input.connect = </mtl/test_materialSG/mul_x.outputs:out>
            color3f outputs:ng_output.connect = </mtl/test_materialSG/NG_switch5/switch5.outputs:out>

            def Shader "switch5_g22_ap1" 
            {
                uniform token info:id = "ND_image_color3"
                asset inputs:file = @textures/g22_ap1.hdr@ (
                    colorSpace = "g22_ap1"
                )
                color3f outputs:out
            }

            def Shader "switch5_untagged_srgb_displayp3" 
            {
                uniform token info:id = "ND_image_color3"
                asset inputs:file = @textures/srgb_displayp3.hdr@ (
                    colorSpace = "srgb_displayp3"
                )
                color3f outputs:out
            }

            def Shader "switch5" 
            {
                uniform token info:id = "ND_switch_color3"
                color3f inputs:in1 = (0.695066, 0.391901, 0.220088) (
                    colorSpace = "adobergb"
                )
                color3f inputs:in2.connect = </mtl/test_materialSG/NG_switch5/switch5_g22_ap1.outputs:out>
                color3f inputs:in3 = (0.733815, 0.413301, 0.24304) (
                    colorSpace = "srgb_displayp3"
                )
                color3f inputs:in4.connect = </mtl/test_materialSG/NG_switch5/switch5_untagged_srgb_displayp3.outputs:out>
                color3f inputs:in5 = (0.577579, 0.12744, 0.0318954) (
                    colorSpace = "none"
                )
                float inputs:which.connect = </mtl/test_materialSG/NG_switch5.inputs:ng_input>
                color3f outputs:out
            }
        }

        def Shader "switches" 
        {
            uniform token info:id = "ND_switch_color3"
            color3f inputs:in1.connect = </mtl/test_materialSG/switch1.outputs:out>
            color3f inputs:in2.connect = </mtl/test_materialSG/switch2.outputs:out>
            color3f inputs:in3.connect = </mtl/test_materialSG/switch3.outputs:out>
            color3f inputs:in4.connect = </mtl/test_materialSG/switch4.outputs:out>
            color3f inputs:in5.connect = </mtl/test_materialSG/NG_switch5.outputs:ng_output>
            float inputs:which.connect = </mtl/test_materialSG/mul_y.outputs:out>
            color3f outputs:out
        }
    }
}
